# Server
PORT=4000

# Data mode: "mock" (default, no DB needed) or "live" (queries the real MySQL DB)
DATA_MODE=mock

# MySQL connection — only required when DATA_MODE=live
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=idh_prod_sync_driver

# CORS — frontend dev server origin
CORS_ORIGIN=http://localhost:5173
